          <div class="course-card bg-white rounded-3xl border border-[#EBE1D9] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden" data-category="baby" data-title="First Foods & Gentle Weaning: 6 to 12 Months">
            <div class="relative h-52 overflow-hidden bg-[#F4EDE7]">
              <img src="https://images.unsplash.com/photo-1596495578065-6e0763fa1178?auto=format&fit=crop&w=800&q=80" alt="Baby eating" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between">
