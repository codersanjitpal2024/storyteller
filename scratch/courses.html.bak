    <div class="modal-backdrop fixed inset-0" onclick="closeCheckout()"></div>
    <div class="relative bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 border border-subtleBorder shadow-2xl z-10">
      <div class="flex items-center justify-between pb-4 border-b border-subtleBorder">
        <div>
          <span class="text-[11px] font-bold text-berry uppercase tracking-wider">SECURE CHECKOUT</span>
          <h3 class="font-serif text-2xl font-normal text-charcoal" id="checkout-course-name">Enroll in Course</h3>
        </div>
        <button onclick="closeCheckout()" class="p-2 rounded-full hover:bg-ivory text-mutedText hover:text-charcoal transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form id="checkout-form" onsubmit="handleCheckout(event)" class="mt-5 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-charcoal mb-1">Your Full Name *</label>
          <input type="text" id="buyer-name" required placeholder="e.g. Radhika Sharma" class="w-full px-4 py-2.5 text-xs rounded-xl border border-subtleBorder bg-[#FCFAF7] focus:ring-2 focus:ring-berry focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-charcoal mb-1">Email Address (For course access link) *</label>
          <input type="email" id="buyer-email" required placeholder="e.g. radhika@example.com" class="w-full px-4 py-2.5 text-xs rounded-xl border border-subtleBorder bg-[#FCFAF7] focus:ring-2 focus:ring-berry focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-charcoal mb-1">WhatsApp Number (For community group & login SMS) *</label>
          <input type="tel" id="buyer-phone" required placeholder="e.g. +91 98765 43210" class="w-full px-4 py-2.5 text-xs rounded-xl border border-subtleBorder bg-[#FCFAF7] focus:ring-2 focus:ring-berry focus:outline-none">
        </div>

        <!-- Coupon row -->
        <div>
          <label class="block text-xs font-semibold text-charcoal mb-1">Discount Code</label>
          <div class="flex gap-2">
            <input type="text" id="coupon-code" placeholder="Try MUMPOWER" class="flex-1 px-4 py-2 text-xs uppercase rounded-xl border border-subtleBorder bg-[#FCFAF7] focus:ring-2 focus:ring-berry focus:outline-none">
            <button type="button" onclick="applyCoupon()" class="px-4 py-2 rounded-xl bg-charcoal text-white text-xs font-semibold hover:bg-black transition-colors">Apply</button>
          </div>
          <span id="coupon-msg" class="text-[11px] font-medium hidden mt-1 block"></span>
        </div>

        <!-- Price breakdown -->
        <div class="p-3.5 rounded-xl bg-ivory/50 border border-subtleBorder text-xs space-y-1.5">
          <div class="flex justify-between text-mutedText">
            <span>Course Fee:</span>
            <span id="summary-orig-price">₹1,499</span>
          </div>
          <div class="flex justify-between text-emerald-700 font-medium hidden" id="discount-row">
            <span>Discount (MUMPOWER):</span>
            <span id="summary-discount">-₹225</span>
          </div>
          <div class="flex justify-between font-bold text-charcoal text-sm pt-2 border-t border-subtleBorder">
            <span>Total Payable:</span>
            <span id="summary-total" class="text-berry">₹1,499</span>
          </div>
        </div>

        <!-- Payment methods -->
        <div>
          <label class="block text-xs font-semibold text-charcoal mb-1.5">Select Payment Method</label>
          <div class="grid grid-cols-3 gap-2">
            <label class="border border-berry bg-berry/5 rounded-xl p-2.5 flex flex-col items-center text-center cursor-pointer">
              <input type="radio" name="payment-method" value="upi" checked class="text-berry focus:ring-berry text-xs">
              <span class="text-xs font-bold text-charcoal mt-1">UPI / GPay</span>
              <span class="text-[9px] text-mutedText">Instant QR</span>
            </label>
            <label class="border border-subtleBorder rounded-xl p-2.5 flex flex-col items-center text-center cursor-pointer hover:bg-ivory">
              <input type="radio" name="payment-method" value="card" class="text-berry focus:ring-berry text-xs">
              <span class="text-xs font-bold text-charcoal mt-1">Card</span>
              <span class="text-[9px] text-mutedText">Debit/Credit</span>
            </label>
            <label class="border border-subtleBorder rounded-xl p-2.5 flex flex-col items-center text-center cursor-pointer hover:bg-ivory">
              <input type="radio" name="payment-method" value="netbanking" class="text-berry focus:ring-berry text-xs">
              <span class="text-xs font-bold text-charcoal mt-1">NetBanking</span>
              <span class="text-[9px] text-mutedText">All Banks</span>
            </label>
          </div>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-full bg-berry text-white text-xs font-bold uppercase tracking-wider hover:bg-berry-hover transition-all shadow-md mt-2">
          Complete Enrollment &rarr;
        </button>
      </form>

      <!-- SUCCESS CONFIRMATION -->
      <div id="checkout-success" class="hidden mt-6 text-center space-y-4">
        <div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h4 class="font-serif text-2xl text-charcoal font-normal">Welcome to the Academy!</h4>
        <p class="text-xs text-mutedText leading-relaxed">
          Your payment was simulated successfully! Your course dashboard access credentials and WhatsApp group invite have been sent to your email.
        </p>
        <div class="p-3 bg-ivory rounded-xl text-xs font-mono text-charcoal">
          Enrollment ID: <strong id="order-id">WTM-2026-8941</strong>
        </div>
        <button onclick="closeCheckout()" class="w-full py-2.5 rounded-full bg-charcoal text-white text-xs font-semibold hover:bg-black">
          Close Window
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- SITE FOOTER                                -->
  <!-- ========================================== -->
  <footer class="w-full bg-[#FDFCFB] relative overflow-hidden border-t border-[#F0EAE6] pt-12 sm:pt-14 select-none">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-8 pb-14">
        <!-- Col 1 -->
        <div class="lg:col-span-4 flex flex-col justify-between pr-0 lg:pr-4">
          <div>
            <a href="index.html" class="inline-block mb-3.5">
              <span class="font-serif text-2xl sm:text-3xl text-charcoal font-normal">WithTheMums<span class="text-berry font-bold">.</span></span>
            </a>
            <p class="text-xs sm:text-[13px] text-[#6E6460] leading-relaxed max-w-sm mt-1">
              A supportive community for every stage of motherhood. Courses, evidence-based guides, and honest stories.
            </p>
          </div>
          <div class="flex items-center gap-2.5 pt-6">
            <a href="https://www.instagram.com/wethemums/" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-[#FAF0ED] text-[#862D42] hover:bg-[#862D42] hover:text-white flex items-center justify-center transition-all shadow-sm">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z"/></svg>
            </a>
          </div>
        </div>

        <!-- Col 2: Navigation Links -->
        <div class="lg:col-span-2 lg:border-l lg:border-[#F0EAE6] lg:pl-7">
          <div class="mb-4">
            <h4 class="text-[11px] sm:text-xs font-bold tracking-[0.14em] text-[#862D42] uppercase">ACADEMY</h4>
            <div class="w-6 h-[1.5px] bg-[#862D42] mt-1.5"></div>
          </div>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-[#4A423F]">
            <li><a href="courses.html" class="hover:text-berry transition-colors font-semibold text-berry">All Masterclasses</a></li>
            <li><a href="courses.html#all-courses" class="hover:text-berry transition-colors">Toddler Discipline</a></li>
            <li><a href="courses.html#all-courses" class="hover:text-berry transition-colors">Baby Weaning</a></li>
            <li><a href="courses.html#all-courses" class="hover:text-berry transition-colors">Gentle Sleep</a></li>
            <li><a href="courses.html#all-courses" class="hover:text-berry transition-colors">Mom Boss Program</a></li>
          </ul>
        </div>

        <!-- Col 3: Editorial -->
        <div class="lg:col-span-3 lg:border-l lg:border-[#F0EAE6] lg:pl-7">
          <div class="mb-4">
            <h4 class="text-[11px] sm:text-xs font-bold tracking-[0.14em] text-[#862D42] uppercase">RESOURCES</h4>
            <div class="w-6 h-[1.5px] bg-[#862D42] mt-1.5"></div>
          </div>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-[#4A423F]">
            <li><a href="journal.html" class="hover:text-berry transition-colors">Blogs by Categories</a></li>
            <li><a href="stories.html" class="hover:text-berry transition-colors">Personal Stories</a></li>
            <li><a href="about.html" class="hover:text-berry transition-colors">Our Advisory Board</a></li>
            <li><a href="contact.html" class="hover:text-berry transition-colors">Student Helpdesk</a></li>
          </ul>
        </div>

        <!-- Col 4: Help -->
        <div class="lg:col-span-3 lg:border-l lg:border-[#F0EAE6] lg:pl-7">
          <div class="mb-4">
            <h4 class="text-[11px] sm:text-xs font-bold tracking-[0.14em] text-[#862D42] uppercase">NEED HELP?</h4>
            <div class="w-6 h-[1.5px] bg-[#862D42] mt-1.5"></div>
          </div>
          <p class="text-xs text-mutedText leading-relaxed mb-3">
            Questions about course enrollment or need recommendations for your child's age?
          </p>
          <a href="contact.html" class="inline-flex items-center gap-1.5 text-xs font-bold text-berry hover:underline">
            Chat With Student Support &rarr;
          </a>
        </div>
      </div>

      <div class="border-t border-[#F0EAE6] py-6 flex flex-col sm:flex-row items-center justify-between text-xs text-mutedText gap-3">
        <p>© 2026 WithTheMums Media & Academy. All rights reserved.</p>
        <p>Evidence-based parenting education & masterclasses.</p>
      </div>
    </div>
  </footer>

  <!-- SCRIPT FOR COURSES, FILTERS & CHECKOUT -->
  <script>
    // Mobile menu toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Category Filtering
    const filterBtns = document.querySelectorAll('.course-filter-btn');
    const courseCards = document.querySelectorAll('.course-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-berry', 'text-white');
          b.classList.add('bg-white', 'text-charcoal/70', 'border', 'border-subtleBorder');
        });
        btn.classList.remove('bg-white', 'text-charcoal/70', 'border', 'border-subtleBorder');
        btn.classList.add('bg-berry', 'text-white');

        const cat = btn.getAttribute('data-category');
        courseCards.forEach(card => {
          if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Real-time search
    const searchInput = document.getElementById('course-search');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        courseCards.forEach(card => {
          const title = card.getAttribute('data-title').toLowerCase();
          const desc = card.innerText.toLowerCase();
          if (title.includes(query) || desc.includes(query)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }

    // Curriculum Preview Data
    const curriculums = {
      toddler: {
        tag: "TODDLER DISCIPLINE",
        title: "The Calm Toddler Blueprint: Syllabus Preview",
        modules: [
          { title: "Module 1: The Neuroscience of a Toddler Meltdown", desc: "Why logic fails during tantrums, the amygdala hijack, and how to co-regulate calmly." },
          { title: "Module 2: 7 Printable Scripts for High-Stress Moments", desc: "Exact phrases for leaving the park, grocery store crying, sharing struggles, and bedtime." },
          { title: "Module 3: Preventing Aggression (Hitting, Biting, Throwing)", desc: "Gentle boundaries that teach emotional regulation without physical punishment or fear." },
          { title: "Module 4: Repair & Reconnection", desc: "How to rebuild trust after a rough day so parent and child feel deeply secure." }
        ]
      },
      weaning: {
        tag: "NUTRITION & SOLIDS",
        title: "First Foods & Gentle Weaning: Syllabus Preview",
        modules: [
          { title: "Module 1: Readiness Signs & Safety Essentials", desc: "When to start, essential high-chair ergonomics, and mastering the difference between gagging and choking." },
          { title: "Module 2: Purees vs. Baby-Led Weaning", desc: "How to combine the best of both approaches for stress-free meal times." },
          { title: "Module 3: Top Allergen Introduction Matrix", desc: "Doctor-approved protocol for safely introducing nuts, eggs, dairy, and fish." },
          { title: "Module 4: 45 Nutrient-Dense Indian Baby Recipes", desc: "Khichdi variations, iron-packed purees, steamed vegetable finger foods, and tiffin meal planners." }
        ]
      },
      sleep: {
        tag: "INFANT & TODDLER SLEEP",
        title: "Gentle Sleep Solutions: Syllabus Preview",
        modules: [
          { title: "Module 1: Circadian Rhythms & Age-Wise Wake Windows", desc: "Calculating optimal nap times and preventing overtired bedtime battles." },
          { title: "Module 2: The 4-Month & 8-Month Sleep Regressions", desc: "Understanding biological brain development and navigating regression without setbacks." },
          { title: "Module 3: Gentle Night-Weaning Without Tears", desc: "Gradual reduction methods that preserve emotional security while sleeping 8+ hour stretches." },
          { title: "Module 4: Smooth Bedtime Routines & Environment Setup", desc: "Lighting, sound machines, sleep sacks, and positive sleep associations." }
        ]
      },
      fourth: {
        tag: "POSTPARTUM HEALTH",
        title: "The Fourth Trimester: Syllabus Preview",
        modules: [
          { title: "Module 1: Pelvic Floor & Core Rehab", desc: "Safe postnatal recovery movements, diastasis recti assessment, and preventing prolapse." },
          { title: "Module 2: Hormones, Baby Blues & PPD Screening", desc: "Distinguishing normal hormonal shifts from postpartum anxiety and where to find clinical help." },
          { title: "Module 3: Breastfeeding & Latch Mastery", desc: "Pain-free latch techniques, blocked ducts relief, and maintaining milk supply." },
          { title: "Module 4: Partner Dynamics & The Mental Load", desc: "Communicating needs without resentment and sharing nighttime duties fairly." }
        ]
      },
      potty: {
        tag: "EARLY CHILDHOOD",
        title: "Potty Training in 5 Days: Syllabus Preview",
        modules: [
          { title: "Module 1: Assessing Genuine Readiness", desc: "The 5 developmental cues before starting, avoiding premature regression." },
          { title: "Module 2: The 5-Day Step-by-Step Schedule", desc: "Detailed hour-by-hour visual routine for day 1 through day 5." },
          { title: "Module 3: Responding to Accidents with Zero Shame", desc: "Positive reinforcement scripts and preventing power struggles over bowel movements." },
          { title: "Module 4: Public Restrooms & Night-time Dryness", desc: "Mastering car rides, preschool transitions, and overnight independence." }
        ]
      },
      momboss: {
        tag: "CAREER & ENTREPRENEURSHIP",
        title: "Mom Boss Masterclass: Syllabus Preview",
        modules: [
          { title: "Module 1: Finding Your High-Profit Niche", desc: "Turning your skills into services, digital products, or consulting from your kitchen table." },
          { title: "Module 2: Realistic Time-Blocking for Mums", desc: "How to build a business in 2 hours during naptime without neglecting your children." },
          { title: "Module 3: Client Attraction & Social Media Growth", desc: "Authentic storytelling strategies that attract paying clients without dancing on Reels." },
          { title: "Module 4: Pricing, Invoicing & Automations", desc: "Setting professional rates and automating admin tasks so the business runs while you play." }
        ]
      }
    };

    function openCurriculum(key) {
      const data = curriculums[key];
      if (!data) return;
      document.getElementById('curr-tag').innerText = data.tag;
      document.getElementById('curr-title').innerText = data.title;
      
      let html = '';
      data.modules.forEach((m, idx) => {
        html += `
          <div class="p-4 rounded-2xl bg-ivory/60 border border-subtleBorder">
            <h4 class="font-semibold text-sm text-charcoal">${m.title}</h4>
            <p class="text-xs text-mutedText mt-1">${m.desc}</p>
          </div>
        `;
      });
      document.getElementById('curr-content').innerHTML = html;
      document.getElementById('curr-modal').style.display = 'flex';
      document.getElementById('curriculum-modal').classList.remove('hidden');
    }

    function closeCurriculum() {
      document.getElementById('curriculum-modal').classList.add('hidden');
    }

    // Checkout Flow
    let currentPrice = 1499;
    let couponApplied = false;

    function openCheckout(courseName, price) {
      closeCurriculum();
      currentPrice = price;
      couponApplied = false;
      document.getElementById('checkout-course-name').innerText = courseName;
      document.getElementById('summary-orig-price').innerText = '₹' + price;
      document.getElementById('summary-total').innerText = '₹' + price;
      document.getElementById('discount-row').classList.add('hidden');
      document.getElementById('coupon-msg').classList.add('hidden');
      document.getElementById('coupon-code').value = '';
      document.getElementById('checkout-form').classList.remove('hidden');
      document.getElementById('checkout-success').classList.add('hidden');
      document.getElementById('checkout-modal').classList.remove('hidden');
    }

    function closeCheckout() {
      document.getElementById('checkout-modal').classList.add('hidden');
    }

    function applyCoupon() {
      const code = document.getElementById('coupon-code').value.trim().toUpperCase();
      const msg = document.getElementById('coupon-msg');
      if (code === 'MUMPOWER') {
        couponApplied = true;
        const discount = Math.round(currentPrice * 0.15);
        const finalPrice = currentPrice - discount;
        document.getElementById('discount-row').classList.remove('hidden');
        document.getElementById('summary-discount').innerText = '-₹' + discount;
        document.getElementById('summary-total').innerText = '₹' + finalPrice;
        msg.className = 'text-[11px] font-medium text-emerald-600 mt-1 block';
        msg.innerText = '✓ Coupon MUMPOWER applied! 15% discount deducted.';
      } else {
        msg.className = 'text-[11px] font-medium text-rose-600 mt-1 block';
        msg.innerText = 'Invalid coupon code. Try MUMPOWER';
      }
    }

    function handleCheckout(e) {
      e.preventDefault();
      const name = document.getElementById('buyer-name').value;
      const email = document.getElementById('buyer-email').value;
      const phone = document.getElementById('buyer-phone').value;
      const course = document.getElementById('checkout-course-name').innerText;
      
      // Save order in localStorage so editorial-dashboard can see course sales!
      try {
        const orders = JSON.parse(localStorage.getItem('wtm_course_orders') || '[]');
        const newOrder = {
          id: 'WTM-' + Math.floor(1000 + Math.random() * 9000),
          course: course,
          name: name,
          email: email,
          phone: phone,
          price: document.getElementById('summary-total').innerText,
          date: new Date().toLocaleDateString('en-GB')
        };
        orders.unshift(newOrder);
        localStorage.setItem('wtm_course_orders', JSON.stringify(orders));
        document.getElementById('order-id').innerText = newOrder.id;
      } catch (err) {
        console.error(err);
      }

      document.getElementById('checkout-form').classList.add('hidden');
      document.getElementById('checkout-success').classList.remove('hidden');
    }

    // FAQ Toggle
    function toggleFaq(el) {
      const p = el.querySelector('div:nth-child(2)');
      const svg = el.querySelector('svg');
      if (p.classList.contains('hidden')) {
        p.classList.remove('hidden');
        svg.classList.add('rotate-180');
      } else {
        p.classList.add('hidden');
        svg.classList.remove('rotate-180');
      }
    }
  </script>
</body>
</html>