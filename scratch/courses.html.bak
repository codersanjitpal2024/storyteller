<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Courses & Masterclasses — WithTheMums | Expert Parenting Academy</title>
  <meta name="description" content="Doctor-approved, practical parenting masterclasses. Toddler discipline, baby sleep, infant weaning, postpartum recovery, and mompreneurship.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- GSAP for smooth interactions -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            berry: {
              DEFAULT: '#862D42',
              hover: '#6F2335',
              dark: '#521927',
              light: '#FAF0ED',
            },
            ivory: {
              light: '#FCFAF7',
              DEFAULT: '#F7F2EC',
              dark: '#EBE2D5',
            },
            dustyRose: {
              light: '#F4DDD7',
              DEFAULT: '#D9A99C',
              dark: '#C38B7C',
            },
            charcoal: {
              DEFAULT: '#221C1D',
              light: '#423F3C',
            },
            mutedText: {
              DEFAULT: '#716A65',
            },
            subtleBorder: {
              DEFAULT: '#E7DDD2',
            }
          },
          fontFamily: {
            serif: ['Newsreader', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    .course-card {
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .course-card:hover {
      transform: translateY(-4px);
    }
    .modal-backdrop {
      background-color: rgba(34, 28, 29, 0.7);
      backdrop-filter: blur(4px);
    }
  </style>
</head>
<body class="bg-[#FCFAF7] text-charcoal font-sans antialiased min-h-screen flex flex-col selection:bg-berry/20">

