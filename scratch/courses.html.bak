          <div class="course-card bg-white rounded-3xl border border-[#EBE1D9] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden" data-category="baby" data-title="Gentle Sleep Solutions: Newborn to 3 Years">
            <div class="relative h-52 overflow-hidden bg-[#F4EDE7]">
              <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=800&q=80" alt="Sleeping baby" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between">
                <span class="px-3 py-1 rounded-full bg-indigo-700 text-white text-[10px] font-bold uppercase tracking-wider shadow-sm">TEAR-FREE METHOD</span>
                <span class="px-2.5 py-1 rounded-full bg-white/95 text-charcoal text-[11px] font-semibold flex items-center gap-1 shadow-xs">
                  <svg class="w-3.5 h-3.5 fill-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  4.8 (1,450)
